rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/backups/{fileName} {
      function ownAccount() {
        return request.auth != null && request.auth.uid == userId
          && fileName.matches('^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}\\.enc$');
      }
      function validEncryptedUpload() {
        return request.resource.size >= 16
          && request.resource.size <= 16 * 1024 * 1024 + 16
          && request.resource.contentType == 'application/octet-stream'
          && request.resource.metadata.ownerId == userId
          && request.resource.metadata.revision + '.enc' == fileName;
      }
      allow get, delete: if ownAccount();
      allow create: if ownAccount() && validEncryptedUpload();
      allow update, list: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
