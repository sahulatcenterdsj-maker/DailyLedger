<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Database (incl. WAL files) and settings are backed up to the user's Google account automatically. -->
    <include domain="database" path="." />
    <include domain="file" path="datastore" />
    <!-- Keystore-bound secret cannot be restored on another device. -->
    <exclude domain="sharedpref" path="secure_secrets.xml" />
        <exclude domain="sharedpref" path="ai_preferences.xml" />
</full-backup-content>
