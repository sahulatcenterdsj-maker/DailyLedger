<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Daily Ledger uses its own authenticated encrypted backup. Do not let Android cloud backup
         upload the plaintext Room database, DataStore, AI cache, or Keystore-bound key cache. -->
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
